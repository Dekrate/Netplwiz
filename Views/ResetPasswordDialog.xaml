<?xml version="1.0" encoding="UTF-8" ?>
<ContentDialog
    x:Class="Netplwiz.Views.ResetPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Resetowanie hasła"
    CloseButtonText="Anuluj"
    DefaultButton="Primary"
    PrimaryButtonText="OK"
    mc:Ignorable="d"
    CornerRadius="12">

    <ContentDialog.PrimaryButtonStyle>
        <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </ContentDialog.PrimaryButtonStyle>
    <ContentDialog.CloseButtonStyle>
        <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </ContentDialog.CloseButtonStyle>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="Nowe hasło:" />
        <PasswordBox
            x:Name="NewPasswordBox"
            Grid.Row="0"
            Grid.Column="1"
            PasswordChanged="OnPasswordChanged" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="Potwierdź nowe hasło:" />
        <PasswordBox
            x:Name="ConfirmPasswordBox"
            Grid.Row="1"
            Grid.Column="1"
            PasswordChanged="OnPasswordChanged" />

        <TextBlock
            x:Name="PolicyHintTextBlock"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="ErrorTextBlock"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Foreground="{ThemeResource SystemErrorTextColor}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</ContentDialog>
