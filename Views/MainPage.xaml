<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Netplwiz.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Netplwiz.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Grid Padding="0,48,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title + About + Settings -->
        <Grid Grid.Row="0" Margin="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                x:Uid="AppTitle" />
            <Button
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Click="SettingsButton_Click"
                x:Uid="SettingsButton" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="AboutButton_Click"
                x:Uid="AboutButton" />
        </Grid>

        <!-- TabView -->
        <TabView
            Grid.Row="1"
            Margin="12,0"
            IsAddTabButtonVisible="False"
            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- Users Tab -->
            <TabViewItem x:Uid="UsersTab">
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        x:Uid="UsersDescription"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="1"
                        FontWeight="SemiBold"
                        x:Uid="UsersLabel" />

                    <ListView
                        x:Name="UsersListView"
                        Grid.Row="2"
                        Margin="0,4,0,8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ItemsSource="{Binding Users}"
                        SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Glyph="&#xE77B;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{Binding UserName}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding GroupsDisplay}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Row="3"
                        Margin="0,4,0,8"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Command="{Binding AddUserCommand}"
                            x:Uid="AddButton" />
                        <Button
                            Command="{Binding RemoveUserCommand}"
                            x:Uid="RemoveButton" />
                        <Button
                            Command="{Binding PropertiesCommand}"
                            x:Uid="PropertiesButton" />
                    </StackPanel>

                    <!-- Password section for selected user -->
                    <Border
                        Grid.Row="4"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding SelectedUser, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Glyph="&#xE77B;" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontWeight="SemiBold">
                                <Run Text="Hasło dla " />
                                <Run Text="{Binding SelectedUser.UserName}" />
                            </TextBlock>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,4,0,0"
                                x:Uid="PasswordSectionDescription"
                                TextWrapping="Wrap" />

                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding ResetPasswordCommand}"
                                x:Uid="ResetPasswordButton" />
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- Advanced Tab -->
            <TabViewItem x:Uid="AdvancedTab">
                <Grid Padding="12" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Passwords -->
                    <Border
                        Grid.Row="0"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                x:Uid="ManagePasswordsDescription"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding ManagePasswordsCommand}"
                                x:Uid="ManagePasswordsButton" />
                        </Grid>
                    </Border>

                    <!-- Advanced user management -->
                    <Border
                        Grid.Row="1"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Glyph="&#xE77B;" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                x:Uid="AdvancedManagementHeader" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,4,0,0"
                                x:Uid="AdvancedManagementDescription"
                                TextWrapping="Wrap" />

                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding AdvancedUserManagementCommand}"
                                x:Uid="AdvancedManagementButton" />
                        </Grid>
                    </Border>

                    <!-- Secure logon -->
                    <Border
                        Grid.Row="2"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Row="0"
                                Grid.RowSpan="4"
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Top"
                                FontSize="24"
                                Glyph="&#xE192;" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                x:Uid="SecureLogonHeader" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                x:Uid="SecureLogonDescription"
                                TextWrapping="Wrap" />

                            <CheckBox
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding SecureLogonRequired, Mode=TwoWay}"
                                x:Uid="SecureLogonCheckBox" />
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>
        </TabView>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusMessage}" />
            <ProgressRing
                Grid.Column="1"
                Width="16"
                Height="16"
                IsActive="{Binding IsLoading}" />
        </Grid>
    </Grid>
</Page>
